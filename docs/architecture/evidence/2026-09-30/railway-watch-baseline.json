{
  "base": "41cbc27029dfffad07ee71e97c3052d9d5d0cabb",
  "services": {
    "indexer": {
      "$schema": "https://railway.com/railway.schema.json",
      "build": {
        "builder": "RAILPACK",
        "buildCommand": "pnpm install --no-frozen-lockfile && pnpm --filter indexer build",
        "watchPatterns": [
          "apps/indexer/**",
          "package.json",
          "pnpm-workspace.yaml"
        ]
      },
      "deploy": {
        "startCommand": "pnpm --filter indexer start",
        "healthcheckPath": "/ready",
        "healthcheckTimeout": 300,
        "restartPolicyType": "ALWAYS",
        "restartPolicyMaxRetries": 10,
        "drainingSeconds": 15
      }
    },
    "market-indexer": {
      "$schema": "https://railway.com/railway.schema.json",
      "build": {
        "builder": "RAILPACK",
        "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter market-indexer build",
        "watchPatterns": [
          "apps/market-indexer/**",
          "package.json",
          "pnpm-lock.yaml",
          "pnpm-workspace.yaml"
        ]
      },
      "deploy": {
        "startCommand": "pnpm --filter market-indexer start",
        "healthcheckPath": "/health",
        "healthcheckTimeout": 300,
        "restartPolicyType": "ALWAYS",
        "restartPolicyMaxRetries": 10,
        "drainingSeconds": 15
      }
    },
    "external-origin-indexer": {
