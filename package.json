{
  "name": "robinhood-meme-terminal",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "audit:production": "pnpm audit --prod --audit-level high",
    "check:community-readiness": "node scripts/check-rmt-live-readiness.mjs",
    "check:repo": "knip --include files,dependencies",
    "lint": "pnpm --filter web lint",
    "test:agent-foundation": "node --experimental-strip-types packages/agent-core/src/smoke.ts && node --experimental-strip-types apps/agent-engine/src/smoke.ts && node --experimental-strip-types apps/agent-engine/src/durability-smoke.ts && node --experimental-strip-types apps/agent-engine/src/strategy-compiler-smoke.ts",
    "test:firebase-rules": "firebase emulators:exec --project rmt-rules-test --only firestore \"pnpm --filter web test:firebase-rules:unit\"",
    "test:community-readiness": "node scripts/community-readiness-smoke.mjs",
    "test:terminal-release": "pnpm --filter web test:terminal-release",
    "test:paused-integrity": "pnpm --filter web test:paused-integrity && pnpm test:community-readiness && pnpm check:community-readiness -- --repository-only",
    "test:production-health": "node scripts/production-health-smoke.mjs",
    "test:terminal-high-end": "node .github/scripts/terminal-high-end-acceptance.mjs",
    "typecheck": "pnpm --filter web typecheck"
  },
  "devDependencies": {
    "firebase-tools": "15.26.0",
    "knip": "6.29.0",
    "playwright": "1.55.1"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server@<2.0.10": "2.0.10",
      "@opentelemetry/core@<2.8.0": "2.8.0",
      "axios@>=1.0.0 <1.18.0": "1.18.0",
      "brace-expansion@<=5.0.8": "5.0.9",
      "fast-uri@>=3.0.0 <3.1.5": "3.1.5",
      "hono@<4.12.34": "4.12.34",
      "ip-address@<10.3.1": "10.3.1",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "nanoid@<3.3.18": "3.3.18",
      "postcss@<=8.5.22": "8.5.23",
      "re2@<=1.26.0": "1.26.1",
      "sharp@<0.35.0": "0.35.0",
      "socket.io-parser@>=4.0.0 <4.2.7": "4.2.7",
      "tar@<=7.5.20": "7.5.21",
      "undici@<6.28.0": "6.28.0",
      "undici@>=8.0.0 <8.9.0": "8.9.0",
      "uuid@<11.1.1": "11.1.1",
      "ws@>=8.0.0 <8.21.0": "8.21.0"
    }
  }
}
