{
  "name": "robinhood-meme-terminal",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "workspaces": [
    "apps/launch-website",
    "apps/indexer"
  ],
  "scripts": {
    "dev": "pnpm --filter @rmt/launch-website exec next dev",
    "build": "pnpm --filter @rmt/launch-website --filter indexer build",
    "typecheck": "pnpm --filter @rmt/launch-website --filter indexer typecheck",
    "test": "pnpm --filter @rmt/launch-website test:history && pnpm --filter indexer test:resilience && node --test scripts/railway-watch-scope.test.mjs",
    "test:release-evidence": "node --test \"docs/evidence/**/*.test.mjs\"",
    "test:production-readiness": "node --test scripts/production-readiness/*.test.mjs",
    "probe:production-readiness": "node scripts/production-readiness/run.mjs",
    "probe:blockscout": "node packages/contracts/scripts/probe-blockscout-4663.mjs",
    "export:blockscout": "node packages/contracts/scripts/export-blockscout-4663.mjs",
    "prepare:unsigned-4663": "node packages/contracts/scripts/prepare-unsigned-4663.mjs",
    "prepare:operations-safe": "node packages/contracts/scripts/prepare-operations-safe.mjs",
    "evaluate:operations-safe": "node packages/contracts/scripts/evaluate-operations-safe-release.mjs",
    "evaluate:release": "node scripts/release/evaluate.mjs",
    "test:release-policy": "node --test scripts/release/*.test.mjs",
    "export:private-phone-review": "node scripts/visual-qa/export-rmt-private-phone-review.mjs",
    "export:owner-safe": "node scripts/visual-qa/export-rmt-owner-safe.mjs",
    "test:owner-wallet": "node scripts/visual-qa/test-rmt-owner-safe.mjs",
    "audit:production": "pnpm audit --prod --audit-level high",
    "check:repo": "knip --include files,dependencies",
    "test:fork-4663": "node packages/contracts/scripts/rehearse-fixed-supply-4663.mjs"
  },
  "devDependencies": {
    "knip": "6.29.0",
    "playwright": "1.55.1"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<=5.0.8": "5.0.9",
      "nanoid@<3.3.18": "3.3.18",
      "postcss@<=8.5.22": "8.5.23",
      "source-map-js@>=1.2.0 <1.2.2": "1.2.2",
      "ws@>=8.0.0 <8.21.0": "8.21.0",
      "zod@<4.6.6": "4.6.6"
    }
  }
}
