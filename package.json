{
  "name": "robinhood-meme-terminal",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "workspaces": [
    "apps/launch-website",
    "apps/indexer"
  ],
  "scripts": {
    "dev": "pnpm --filter @rmt/launch-website exec next dev",
    "build": "pnpm --filter @rmt/launch-website --filter indexer build",
    "typecheck": "pnpm --filter @rmt/launch-website --filter indexer typecheck",
    "test": "pnpm --filter @rmt/launch-website test:history && pnpm --filter indexer test:resilience && node --test scripts/railway-watch-scope.test.mjs",
    "test:profiles": "node scripts/profiles/run-emulator-tests.mjs",
    "test:polish": "node scripts/visual-qa/rmt-polish.mjs",
    "test:profiles:server": "node scripts/profiles/run-emulator-tests.mjs --command \"pnpm --filter @rmt/launch-website exec tsx --test lib/server/profiles/core.test.ts lib/server/profiles/emulator.test.ts\"",
    "test:profiles:browser": "node scripts/profiles/run-emulator-tests.mjs --command \"node apps/launch-website/scripts/profile-ui-smoke.mjs\"",
    "test:profiles:http": "node scripts/profiles/run-emulator-tests.mjs --command \"node --test apps/launch-website/lib/server/profiles/next-http-acceptance.mjs\"",
    "test:release-evidence": "node scripts/release-evidence-tests.mjs",
    "test:production-readiness": "node --test scripts/production-readiness/*.test.mjs",
    "probe:production-readiness": "node scripts/production-readiness/run.mjs",
    "probe:blockscout": "node packages/contracts/scripts/probe-blockscout-4663.mjs",
    "export:blockscout": "node packages/contracts/scripts/export-blockscout-4663.mjs",
    "prepare:unsigned-4663": "node packages/contracts/scripts/prepare-unsigned-4663.mjs",
    "prepare:protocol-continuation": "node packages/contracts/scripts/prepare-protocol-continuation.mjs",
    "probe:directory-constructor": "node packages/contracts/scripts/constructor-readiness.mjs",
    "probe:protocol-constructor": "node packages/contracts/scripts/protocol-constructor-readiness.mjs",
    "test:constructor-readiness": "node --test packages/contracts/scripts/constructor-readiness.test.mjs packages/contracts/scripts/protocol-constructor-readiness.test.mjs",
    "verify:protocol-receipt": "node scripts/production-readiness/protocol-receipt.mjs",
    "prepare:governance-publication": "node packages/contracts/scripts/prepare-governance-publication.mjs",
    "prepare:governance-transaction": "node packages/contracts/scripts/prepare-governance-transaction.mjs",
    "verify:governance-receipt": "node scripts/production-readiness/governance-receipt.mjs",
    "test:governance-transaction": "node --test packages/contracts/scripts/governance-transaction.test.mjs",
    "verify:governance-authorization": "node packages/contracts/scripts/verify-governance-authorization.mjs",
    "test:governance-publication": "node --test packages/contracts/scripts/governance-publication.test.mjs",
    "test:protocol-continuation": "node --test packages/contracts/scripts/prepare-protocol-continuation.test.mjs",
    "watch:reserve-receipt": "node scripts/production-readiness/watch-safe.mjs --role RMT-RESERVE",
    "prepare:operations-safe": "node packages/contracts/scripts/prepare-operations-safe.mjs",
    "evaluate:operations-safe": "node packages/contracts/scripts/evaluate-operations-safe-release.mjs",
    "evaluate:release": "node scripts/release/evaluate.mjs",
    "test:release-policy": "node --test scripts/release/*.test.mjs",
    "export:private-phone-review": "node scripts/visual-qa/export-rmt-private-phone-review.mjs",
    "export:owner-safe": "node scripts/visual-qa/export-rmt-owner-safe.mjs",
    "export:owner-protocol": "node scripts/visual-qa/export-rmt-owner-protocol.mjs",
    "export:owner-protocol-stage": "node scripts/visual-qa/export-rmt-owner-protocol-stage.mjs",
    "export:governance-review": "node scripts/visual-qa/export-rmt-governance-review.mjs",
    "export:owner-governance": "node scripts/visual-qa/export-rmt-owner-governance.mjs",
    "test:owner-wallet": "node scripts/visual-qa/test-rmt-owner-safe.mjs",
    "test:owner-protocol": "node scripts/visual-qa/test-rmt-owner-protocol.mjs",
    "test:owner-protocol-stage": "node scripts/visual-qa/test-rmt-owner-protocol-stage.mjs",
    "test:governance-review": "node scripts/visual-qa/test-rmt-governance-review.mjs",
    "test:owner-governance": "node scripts/visual-qa/test-rmt-owner-governance.mjs",
    "audit:production": "pnpm audit --prod --audit-level high",
    "check:repo": "knip --include files,dependencies",
    "test:fork-4663": "node packages/contracts/scripts/rehearse-fixed-supply-4663.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.4.0",
    "firebase-tools": "15.36.0",
    "knip": "6.29.0",
    "playwright": "1.55.1"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<5.0.13": "5.0.13",
      "smol-toml@<1.9.1": "1.9.1",
      "@grpc/grpc-js@<1.14.7": "1.14.7",
      "picomatch@>=4.0.0 <4.0.7": "4.0.7",
      "nanoid@<3.3.18": "3.3.18",
      "postcss@<=8.5.22": "8.5.23",
      "source-map-js@>=1.2.0 <1.2.2": "1.2.2",
      "ws@>=8.0.0 <8.21.0": "8.21.0",
      "zod@<4.6.6": "4.6.6"
    },
    "patchedDependencies": {
      "jwks-rsa@4.1.0": "patches/jwks-rsa@4.1.0.patch"
    }
  }
}
