{
  "name": "robinhood-meme-terminal",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "workspaces": [
    "apps/launch-website",
    "apps/indexer"
  ],
  "scripts": {
    "dev": "pnpm --filter @rmt/launch-website exec next dev",
    "build": "pnpm --filter @rmt/launch-website --filter indexer build",
    "typecheck": "pnpm --filter @rmt/launch-website --filter indexer typecheck",
    "test": "pnpm --filter @rmt/launch-website test:history && pnpm --filter indexer test:resilience && node --test scripts/railway-watch-scope.test.mjs",
    "test:release-evidence": "node --test \"docs/evidence/**/*.test.mjs\"",
    "audit:production": "pnpm audit --prod --audit-level high",
    "check:repo": "knip --include files,dependencies",
    "test:fork-4663": "node packages/contracts/scripts/rehearse-fixed-supply-4663.mjs"
  },
  "devDependencies": {
    "knip": "6.29.0",
    "playwright": "1.55.1"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<=5.0.8": "5.0.9",
      "nanoid@<3.3.18": "3.3.18",
      "postcss@<=8.5.22": "8.5.23",
      "source-map-js@>=1.2.0 <1.2.2": "1.2.2",
      "ws@>=8.0.0 <8.21.0": "8.21.0",
      "zod@<4.6.6": "4.6.6"
    }
  }
}
