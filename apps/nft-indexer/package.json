{
  "name": "nft-indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx src/config-smoke.ts && tsx src/source-verification-smoke.ts && tsx src/activity-smoke.ts && tsx src/storage-smoke.ts && tsx src/worker-smoke.ts && tsx src/worker-reorg-smoke.ts"
  },
  "dependencies": {
    "@rmt/shared": "workspace:*",
    "pg": "8.22.0",
    "viem": "2.55.5"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/pg": "8.20.0",
    "tsx": "4.23.0",
    "typescript": "5.9.3"
  }
}
