{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter nft-indexer build",
    "watchPatterns": [
      "apps/nft-indexer/src/**",
      "apps/nft-indexer/package.json",
      "apps/nft-indexer/tsconfig.json",
      "apps/nft-indexer/railway.json",
      "packages/shared/src/**",
      "packages/shared/package.json",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml"
    ]
  },
  "deploy": {
    "startCommand": "pnpm --filter nft-indexer start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ALWAYS",
    "restartPolicyMaxRetries": 10,
    "drainingSeconds": 15
  }
}
