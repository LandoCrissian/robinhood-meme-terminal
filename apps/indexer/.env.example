# Secrets: configure these in the hosting provider, never in Git.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
RMT_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Deployed RMT V4 release.
RMT_FACTORY_ADDRESS=0x88b86F10D874C2e3C8CfE63161ffa969f3273Cd4
RMT_FACTORY_START_BLOCK=8862129

# Safe production defaults.
RMT_CONFIRMATION_DEPTH=20
RMT_INDEXER_CHUNK_SIZE=2000
RMT_INDEXER_POLL_MS=5000
RMT_DB_POOL_SIZE=10
PGSSLMODE=require

# PORT is normally injected automatically by the hosting provider.
