# Secrets: configure these in the hosting provider, never in Git.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
RMT_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Required canonical V6 deployment values. There are intentionally no V5 fallbacks.
# Startup fails unless the configured factory reports protocolVersion() == 6.
# Governance, creator-payout authority, and protocol treasury are derived from
# the factory's policy registry and must pass the V6 onchain binding checks.
# The archive RPC must prove the factory has code at this exact start block and
# no code at the preceding block.
RMT_FACTORY_ADDRESS=
RMT_FACTORY_START_BLOCK=

# Shared server-only bearer token used by the web tier. Generate a long random value
# and configure the identical secret in the indexer and Vercel production environments.
RMT_INDEXER_READ_TOKEN=

# Safe production defaults.
RMT_CONFIRMATION_DEPTH=20
RMT_INDEXER_CHUNK_SIZE=2000
RMT_INDEXER_POLL_MS=10000
RMT_DB_POOL_SIZE=10
PGSSLMODE=require

# PORT is normally injected automatically by the hosting provider.
