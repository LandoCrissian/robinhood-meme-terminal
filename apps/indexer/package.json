{
  "name": "indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:schema": "tsx src/schema-smoke.ts",
    "test:empty-market": "tsx src/backfill-http-smoke.ts --empty-market",
    "test:backfill-http": "tsx src/backfill-http-smoke.ts",
    "test:activity-backlog": "tsx src/activity-backlog-smoke.ts",
    "test:provider-budget": "tsx --test src/feed-scheduler.test.ts",
    "test:resilience": "tsx src/rpc-resilience-smoke.ts",
    "test:worker-http": "node dist/worker-http-smoke.js",
    "test:curve-production": "tsx src/curve-production-postgres-smoke.ts",
    "start:curve-fixture": "node dist/curve-fixture-worker.js"
  },
  "dependencies": {
    "pg": "^8.13.3",
    "viem": "^2.55.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
