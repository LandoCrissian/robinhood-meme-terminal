# Public release gate. Omit or set to "testnet" during development.
# Set to "mainnet" only after CI and the mainnet release checklist pass.
NEXT_PUBLIC_RMT_NETWORK=testnet

# Testnet-only override. Mainnet resolves its active factory through a version
# registry instead of trusting a browser-provided factory address.
NEXT_PUBLIC_FACTORY_ADDRESS=

# Mainnet is V6-only and fails closed if either exact value is missing or changed.
# /api/health publishes both values so a deployment regression is visible.
NEXT_PUBLIC_VERSION_REGISTRY_ADDRESS=0x27c0269e16209eee149e2738d0819a2633f44246
NEXT_PUBLIC_FACTORY_START_BLOCK=10248855

NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Use the public 25-character app ID shown in Privy's dashboard. Invalid values
# fail closed to RMT's existing wallet connection instead of loading Privy.
NEXT_PUBLIC_PRIVY_APP_ID=
# Server-only public verification key from Privy Dashboard > User management >
# Authentication > Advanced. Enable "Return user data in an identity token"
# before setting this value. RMT verifies the signed Privy identity server-side
# before creating the short-lived Firebase session used for private cloud data.
# Preserve line breaks as escaped \n characters in hosted environments. Although
# this is a public verification key, never prefix server configuration with NEXT_PUBLIC_.
PRIVY_VERIFICATION_KEY=
# Phone verification may be linked to an existing Privy account, but RMT text
# delivery remains protected by a source-level release lock. Do not set these
# variables until carrier registration, the STOP webhook, background evaluator,
# staging evidence and a deliberate spending limit are all approved together.
RMT_SMS_ALERTS_ENABLED=false
RMT_SMS_PROVIDER=twilio
RMT_SMS_COMPLIANCE_CONFIRMED=false
RMT_SMS_DAILY_BUDGET_CENTS=100
# This hard count is the enforceable circuit breaker. The cent budget is also
# recorded for operations because carrier-specific fees cannot be known exactly
# before delivery receipts arrive.
RMT_SMS_MAX_MESSAGES_PER_DAY=25
# Use a random server-only bearer token for the scheduled evaluator. It is never
# placed in browser code or query parameters.
RMT_SMS_EVALUATOR_TOKEN=
# Twilio signs the exact canonical webhook URL derived from this origin.
RMT_PUBLIC_ORIGIN=https://www.rmtlaunch.fun
# Generate two different high-entropy secrets. The encryption key must be the
# canonical base64 encoding of exactly 32 random bytes. Never expose either one.
RMT_SMS_PHONE_ENCRYPTION_KEY=
RMT_SMS_PHONE_HASH_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Privy officially lists Robinhood Chain as a supported wallet-action network.
# Unified funding remains an explicit release gate because the dashboard methods,
# provider eligibility and production quote still require end-to-end validation.
# Hosted previews should use sandbox. RMT never accepts card, bank or KYC data.
NEXT_PUBLIC_PRIVY_FUNDING_ENABLED=false
NEXT_PUBLIC_PRIVY_FUNDING_CHAIN_ID=4663
# Privy requires an exact destination token address. The zero address means
# native ETH; symbols such as "eth" are not accepted by the funding API.
NEXT_PUBLIC_PRIVY_FUNDING_ASSET=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_PRIVY_FUNDING_DEFAULT_AMOUNT=50
NEXT_PUBLIC_PRIVY_FUNDING_ENVIRONMENT=sandbox
# Privy wallet-action swaps are intentionally not enabled here. Same-chain swaps
# may include a Privy fee and require app-funded gas sponsorship; RMT continues
# to use independently decoded DEX routes until an RMT-owned, disclosed fee and
# treasury path is separately reviewed.

# Server-only RMT execution-fee release gate. The v3/v4 payout calldata and
# independent decoder are implemented together, but this stays disabled until
# the treasury, disclosures, staged route simulations and release approval are
# complete. Never prefix the treasury with NEXT_PUBLIC_. The initial target is
# 25 bps (0.25%) with a hard software ceiling of 100 bps.
RMT_EXECUTION_FEE_ENABLED=false
RMT_EXECUTION_FEE_BPS=25
RMT_EXECUTION_FEE_TREASURY=
# Use http://localhost:3000 for local work. Production must use the exact public
# HTTPS origin; the release console will not reopen from a preview or local origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Robinhood Connect must stay disabled until Robinhood approves RMT and supplies
# the exact partner checkout/SDK configuration. The URL must be HTTPS on an
# official robinhood.com host. Never place secret credentials in NEXT_PUBLIC_*.
NEXT_PUBLIC_ROBINHOOD_CONNECT_ENABLED=false
NEXT_PUBLIC_ROBINHOOD_CONNECT_URL=

# Browser RPCs are public by definition. Use a production provider endpoint restricted
# to the RMT domains and set provider-side rate/spend limits; never expose an unrestricted key.
NEXT_PUBLIC_RMT_RPC_URL=
NEXT_PUBLIC_RMT_TESTNET_RPC_URL=

# Server-only archive-capable production RPC for feeds and health checks.
RMT_RPC_URL=
RMT_TESTNET_RPC_URL=

# Server-only confirmed market-data service. Point this at the protected production
# indexer origin; browsers call the same-origin cached proxy and never receive this URL or token.
RMT_INDEXER_URL=
RMT_INDEXER_READ_TOKEN=
RMT_INDEXER_TIMEOUT_MS=5000

# Sushi integration. Both gates default off. Quote discovery uses Sushi's
# official server-side v7 API and never returns executable calldata. Enable the
# public gate only alongside the server gate after staging validation.
NEXT_PUBLIC_RMT_SUSHI_QUOTES_ENABLED=false
RMT_SUSHI_QUOTES_ENABLED=false

# Local-only deployment consoles. Every production build hard-404s these routes,
# even when a flag is set. Enable only in a loopback development session; never
# copy any of these values into a hosted environment.
RMT_OPERATOR_CONSOLES_ENABLED=false
RMT_CONSENT_TESTNET_DEPLOYMENT_ENABLED=false
RMT_CONSENT_TESTNET_ACTIVATION_ENABLED=false

# Public support address shown on the Support page. Use a dedicated project inbox;
# never use a signer-wallet email or any address that receives recovery phrases.
NEXT_PUBLIC_RMT_SUPPORT_EMAIL=

# Firebase private-data sync. Privy is RMT's only visible account layer; the
# browser exchanges a server-verified Privy identity for a short-lived Firebase
# custom session. Do not enable or advertise a second Firebase sign-in flow.
# Firebase web configuration identifies the project but does not authorize data
# access; Firestore rules in /firestore.rules enforce Privy-bound ownership.
# Leave all values empty to keep RMT in local-profile mode.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only Firebase Admin credentials for Privy-to-Firebase custom sessions
# and RMT Live server-mediated writes. Use a dedicated, least-privilege service
# account. Never prefix these with NEXT_PUBLIC_, paste them into browser code,
# or commit real values. Preserve private-key line breaks as escaped \n.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Server-only HMAC secret for irreversible public community author keys.
# Generate at least 32 random characters. Rotating it changes every public
# Guest-XXXX label and must be treated as a moderated identity migration.
COMMUNITY_IDENTITY_SECRET=

# Optional defense-in-depth for Firestore abuse. Configure a reCAPTCHA Enterprise
# App Check site key, monitor enforcement metrics first, and review its quota/pricing.
# Never use an App Check debug token in a public deployment.
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=

# Server-only. Never prefix this with NEXT_PUBLIC_ or expose it in browser code.
PINATA_JWT=
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/
