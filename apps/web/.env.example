# Set only after MemeLaunchFactory is deployed and verified on Robinhood Chain testnet.
# The launch button and live feed remain disabled when this is missing or invalid.
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only. Never prefix this with NEXT_PUBLIC_ or expose it in browser code.
PINATA_JWT=
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/

# Deployment block for efficient, deterministic event indexing.
# When omitted, the alpha feed scans only the latest 20,000 blocks.
NEXT_PUBLIC_FACTORY_START_BLOCK=
