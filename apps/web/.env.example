# Public release gate. Omit or set to "testnet" during development.
# Set to "mainnet" only after CI and the mainnet release checklist pass.
NEXT_PUBLIC_RMT_NETWORK=testnet

# Testnet-only override. Mainnet resolves its active factory through a version
# registry instead of trusting a browser-provided factory address.
NEXT_PUBLIC_FACTORY_ADDRESS=

# Mainnet is V6-only and fails closed if either exact value is missing or changed.
# /api/health publishes both values so a deployment regression is visible.
NEXT_PUBLIC_VERSION_REGISTRY_ADDRESS=0x27c0269e16209eee149e2738d0819a2633f44246
NEXT_PUBLIC_FACTORY_START_BLOCK=10248855

NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Use the public 25-character app ID shown in Privy's dashboard. Invalid values
# fail closed to RMT's existing wallet connection instead of loading Privy.
NEXT_PUBLIC_PRIVY_APP_ID=
# Server-only public verification key from Privy Dashboard > User management >
# Authentication > Advanced. Enable "Return user data in an identity token"
# before setting this value. RMT verifies the signed Privy identity server-side
# before creating the short-lived Firebase session used for private cloud data.
# Preserve line breaks as escaped \n characters in hosted environments. Although
# this is a public verification key, never prefix server configuration with NEXT_PUBLIC_.
PRIVY_VERIFICATION_KEY=

# Live Position Guard remains unavailable unless this complete release set is
# configured. The executor must be the independently verified deployment of
# RMTPositionGuardExecutor. The Privy signer must carry a nonempty policy limited
# to chain 4663, the executor and executeV3Exit; never attach an unrestricted
# signer. The authorization key is a base64 PKCS#8 P-256 private key held only
# by the server. Keep the worker flag false until its heartbeat is visible and
# the release checklist is complete.
NEXT_PUBLIC_RMT_LIVE_POSITION_GUARD_ENABLED=false
NEXT_PUBLIC_RMT_POSITION_GUARD_EXECUTOR=
NEXT_PUBLIC_RMT_POSITION_GUARD_SIGNER_ID=
NEXT_PUBLIC_RMT_POSITION_GUARD_POLICY_ID=
PRIVY_APP_SECRET=
RMT_POSITION_GUARD_AUTHORIZATION_PRIVATE_KEY=
RMT_POSITION_GUARD_EVALUATOR_TOKEN=
RMT_POSITION_GUARD_WORKER_ENABLED=false
# Phone verification may be linked to an existing Privy account, but RMT text
# delivery remains protected by a source-level release lock. Do not set these
# variables until carrier registration, the STOP webhook, background evaluator,
# staging evidence and a deliberate spending limit are all approved together.
RMT_SMS_ALERTS_ENABLED=false
RMT_SMS_PROVIDER=twilio
RMT_SMS_COMPLIANCE_CONFIRMED=false
RMT_SMS_DAILY_BUDGET_CENTS=100
# This hard count is the enforceable circuit breaker. The cent budget is also
# recorded for operations because carrier-specific fees cannot be known exactly
# before delivery receipts arrive.
RMT_SMS_MAX_MESSAGES_PER_DAY=25
# Use a random server-only bearer token for the scheduled evaluator. It is never
# placed in browser code or query parameters.
RMT_SMS_EVALUATOR_TOKEN=
# Twilio signs the exact canonical webhook URL derived from this origin.
RMT_PUBLIC_ORIGIN=https://www.rmtlaunch.fun
# Generate two different high-entropy secrets. The encryption key must be the
# canonical base64 encoding of exactly 32 random bytes. Never expose either one.
RMT_SMS_PHONE_ENCRYPTION_KEY=
RMT_SMS_PHONE_HASH_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Privy officially lists Robinhood Chain as a supported wallet-action network.
# Unified funding remains an explicit release gate because the dashboard methods,
# provider eligibility and production quote still require end-to-end validation.
# Hosted previews should use sandbox. RMT never accepts card, bank or KYC data.
NEXT_PUBLIC_PRIVY_FUNDING_ENABLED=false
# Set only after the configured provider returns an exact quote for the chain,
# asset and destination in this deployment environment.
NEXT_PUBLIC_PRIVY_FUNDING_PROVIDER_VERIFIED=false
NEXT_PUBLIC_PRIVY_FUNDING_CHAIN_ID=4663
# Privy requires an exact destination token address. The zero address means
# native ETH; symbols such as "eth" are not accepted by the funding API.
NEXT_PUBLIC_PRIVY_FUNDING_ASSET=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_PRIVY_FUNDING_DEFAULT_AMOUNT=50
NEXT_PUBLIC_PRIVY_FUNDING_ENVIRONMENT=sandbox
# Privy wallet-action swaps are intentionally not enabled here. Same-chain swaps
# may include a Privy fee and require app-funded gas sponsorship; RMT continues
# to use independently decoded DEX routes until an RMT-owned, disclosed fee and
# treasury path is separately reviewed.

# Server-only RMT execution-fee release gate. The v3/v4 payout calldata and
# independent decoder are implemented together, but this stays disabled until
# the treasury, disclosures, staged route simulations and release approval are
# complete. Never prefix the treasury with NEXT_PUBLIC_. The versioned policy
# and Safe treasury are documented, but these compatibility values remain blank
# until the separately reviewed production release.
RMT_EXECUTION_FEE_ENABLED=false
RMT_EXECUTION_FEE_BPS=
RMT_EXECUTION_FEE_TREASURY=

# Canonical VNext execution-revenue path. These two server-only gates must be
# enabled together; neither can activate collection alone. Keep them false
# until the exact executor deployment, immutable constructor values, public
# treasury, wallet disclosures, receipt reconciliation and controlled proof are
# independently approved. The exact prepared values live in the deployment
# manifest; do not copy them into production merely because the manifest exists.
# The settlement registry is a comma-separated list of exact chain-qualified
# identities, never token symbols.
RMT_VNEXT_EXECUTION_FEE_POLICY_ENABLED=false
RMT_VNEXT_UNISWAP_V3_FEE_AUTHORIZATION_ENABLED=false
# Separate server-only public release gate. Keep false after merging the public
# release code. It can only widen routing when the policy/provider/global gates,
# exact proof wallet, pinned executor and admitted mainnet proof all agree.
RMT_VNEXT_UNISWAP_V3_FEE_PUBLIC_AUTHORIZATION_ENABLED=false
RMT_VNEXT_UNISWAP_V3_FEE_EXECUTOR_ADDRESS=
RMT_VNEXT_UNISWAP_V3_FEE_EXECUTOR_RUNTIME_HASH=
# Immutable controlled-proof binding. While the public authorization gate is
# disabled, only this exact authenticated recipient can receive a fee-bearing
# quote; every other wallet stays fee-free.
RMT_VNEXT_UNISWAP_V3_FEE_PROOF_WALLET=
RMT_VNEXT_EXECUTION_FEE_TREASURY=
RMT_VNEXT_EXECUTION_FEE_POLICY_FROM_BLOCK=
RMT_VNEXT_EXECUTION_FEE_POLICY_BEFORE_BLOCK=
RMT_VNEXT_EXECUTION_FEE_SETTLEMENT_ASSET_IDS=
# Use http://localhost:3000 for local work. Production must use the exact public
# HTTPS origin; the release console will not reopen from a preview or local origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Robinhood Connect must stay disabled until Robinhood approves RMT and supplies
# the exact partner checkout/SDK configuration. The URL must be HTTPS on an
# official robinhood.com host. Never place secret credentials in NEXT_PUBLIC_*.
NEXT_PUBLIC_ROBINHOOD_CONNECT_ENABLED=false
NEXT_PUBLIC_ROBINHOOD_CONNECT_URL=

# Browser RPCs are public by definition. Use a production provider endpoint restricted
# to the RMT domains and set provider-side rate/spend limits; never expose an unrestricted key.
NEXT_PUBLIC_RMT_RPC_URL=
NEXT_PUBLIC_RMT_TESTNET_RPC_URL=

# Server-only archive-capable production RPC for feeds and health checks.
RMT_RPC_URL=
RMT_TESTNET_RPC_URL=

# Server-only confirmed market-data service. Point this at the protected production
# indexer origin; browsers call the same-origin cached proxy and never receive this URL or token.
RMT_INDEXER_URL=
RMT_INDEXER_READ_TOKEN=
RMT_INDEXER_TIMEOUT_MS=5000

# Sushi integration. Both gates default off. Quote discovery uses Sushi's
# official server-side v7 API and never returns executable calldata. Enable the
# public gate only alongside the server gate after staging validation.
NEXT_PUBLIC_RMT_SUSHI_QUOTES_ENABLED=false
RMT_SUSHI_QUOTES_ENABLED=false

# Canonical production terminal shell. Production `/` fails closed unless this
# server-only rollback gate is explicitly enabled. This flag never enables
# wallet authorization, submission, providers, funding, or execution fees.
RMT_VNEXT_SHELL_ENABLED=false

# VNext execution gates. Preparing a payload requires both authorization flags.
# Requesting a wallet prompt additionally requires the wallet-submission flag.
# Keep all three false until the release checklist and connected-wallet review pass.
NEXT_PUBLIC_RMT_VNEXT_AUTHORIZATION_ENABLED=false
RMT_VNEXT_AUTHORIZATION_ENABLED=false
NEXT_PUBLIC_RMT_VNEXT_WALLET_SUBMISSION_ENABLED=false

# Server-only credential for the read-only VNext 0x provider benchmark. Never
# prefix this with NEXT_PUBLIC_, expose it in browser code, or commit a real key.
RMT_ZEROX_API_KEY=

# Server-only observation gate for 0x Swap and Gasless indicative prices.
# Keep false until the adapter is preview-verified. This never enables signing.
RMT_VNEXT_ZEROX_OBSERVATION_ENABLED=false

# Server-only credential for read-only Uniswap Trading API /quote benchmarks.
# The benchmark never calls /order or /swap and never signs or submits anything.
RMT_UNISWAP_API_KEY=

# Server-only observation gate for live UniswapX V3 indicative quotes. Keep
# false until preview verification. This never calls /order or enables signing.
RMT_VNEXT_UNISWAPX_OBSERVATION_ENABLED=false

# Server-only observation and provider authorization gates for up. v2 and up.
# Slipstream. Runtime identities, dependencies, pools and live fees are checked
# before exact calldata simulation. Authorization also requires both global
# authorization gates; an actual prompt additionally requires wallet submission.
# Keep every up. gate false until each controlled USDG/WETH proof is complete.
RMT_VNEXT_UP_V2_OBSERVATION_ENABLED=false
RMT_VNEXT_UP_CL_OBSERVATION_ENABLED=false
RMT_VNEXT_UP_V2_AUTHORIZATION_ENABLED=false
RMT_VNEXT_UP_CL_AUTHORIZATION_ENABLED=false
RMT_VNEXT_UP_RPC_URL=
RMT_VNEXT_UP_PROOF_WALLET=
RMT_VNEXT_UP_PREFLIGHT_INPUT_ASSET=
RMT_VNEXT_UP_PREFLIGHT_OUTPUT_ASSET=
RMT_VNEXT_UP_PREFLIGHT_AMOUNT_ATOMIC=

# Across is a cross-chain FUNDING rail only: native Circle USDC on Ethereum,
# Arbitrum, or Base -> canonical USDG on Robinhood Chain -> the user's wallet.
# Keep quote and authorization gates false until all three small-value mainnet
# proofs, destination receipt checks, and refund/recovery rehearsal pass. Turning
# either gate off must not disable tracking of already-submitted deposits.
RMT_ACROSS_API_KEY=
RMT_ACROSS_INTEGRATOR_ID=
RMT_ACROSS_ETHEREUM_SPOKE_POOL_PROXY_CODE_HASH=
RMT_ACROSS_ETHEREUM_SPOKE_POOL_IMPLEMENTATION_ADDRESS=
RMT_ACROSS_ETHEREUM_SPOKE_POOL_IMPLEMENTATION_CODE_HASH=
RMT_ACROSS_ARBITRUM_SPOKE_POOL_PROXY_CODE_HASH=
RMT_ACROSS_ARBITRUM_SPOKE_POOL_IMPLEMENTATION_ADDRESS=
RMT_ACROSS_ARBITRUM_SPOKE_POOL_IMPLEMENTATION_CODE_HASH=
RMT_ACROSS_BASE_SPOKE_POOL_PROXY_CODE_HASH=
RMT_ACROSS_BASE_SPOKE_POOL_IMPLEMENTATION_ADDRESS=
RMT_ACROSS_BASE_SPOKE_POOL_IMPLEMENTATION_CODE_HASH=
RMT_ACROSS_ROBINHOOD_SPOKE_POOL_PROXY_CODE_HASH=
RMT_ACROSS_ROBINHOOD_SPOKE_POOL_IMPLEMENTATION_ADDRESS=
RMT_ACROSS_ROBINHOOD_SPOKE_POOL_IMPLEMENTATION_CODE_HASH=
RMT_VNEXT_ACROSS_FUNDING_QUOTES_ENABLED=false
RMT_VNEXT_ACROSS_FUNDING_AUTHORIZATION_ENABLED=false

# Local read-only readiness/preflight inputs. The readiness command checks the
# same wallet against exact native Circle USDC on Base, Arbitrum, and Ethereum;
# it never signs, approves, bridges, or submits a transaction.
RMT_ACROSS_PREFLIGHT_WALLET=
RMT_ACROSS_PREFLIGHT_AMOUNT_ATOMIC=
# The strict single-route preflight additionally requires the selected chain and
# exact trusted USDC contract. Use 8453, 42161, or 1—never a token symbol.
RMT_ACROSS_PREFLIGHT_SOURCE_CHAIN_ID=
RMT_ACROSS_PREFLIGHT_SOURCE_TOKEN=

# Server-only RPCs used to verify Across SpokePool runtime bytecode and funding
# lifecycle receipts. Public fallbacks are local/read-only only. Production
# readiness requires all four dedicated HTTPS endpoints plus bearer tokens;
# never embed provider credentials in these URLs.
RMT_ETHEREUM_RPC_URL=
RMT_ETHEREUM_RPC_AUTH_TOKEN=
RMT_ARBITRUM_RPC_URL=
RMT_ARBITRUM_RPC_AUTH_TOKEN=
RMT_BASE_RPC_URL=
RMT_BASE_RPC_AUTH_TOKEN=
RMT_ACROSS_ROBINHOOD_RPC_URL=
RMT_ACROSS_ROBINHOOD_RPC_AUTH_TOKEN=

# Local-only deployment consoles. Every production build hard-404s these routes,
# even when a flag is set. Enable only in a loopback development session; never
# copy any of these values into a hosted environment.
RMT_OPERATOR_CONSOLES_ENABLED=false
RMT_CONSENT_TESTNET_DEPLOYMENT_ENABLED=false
RMT_CONSENT_TESTNET_ACTIVATION_ENABLED=false

# Public support address shown on the Support page. Use a dedicated project inbox;
# never use a signer-wallet email or any address that receives recovery phrases.
NEXT_PUBLIC_RMT_SUPPORT_EMAIL=

# Firebase private-data sync. Privy is RMT's only visible account layer; the
# browser exchanges a server-verified Privy identity for a short-lived Firebase
# custom session. Do not enable or advertise a second Firebase sign-in flow.
# Firebase web configuration identifies the project but does not authorize data
# access; Firestore rules in /firestore.rules enforce Privy-bound ownership.
# Leave all values empty to keep RMT in local-profile mode.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only Firebase Admin credentials for Privy-to-Firebase custom sessions
# and RMT Live server-mediated writes. Use a dedicated, least-privilege service
# account. Never prefix these with NEXT_PUBLIC_, paste them into browser code,
# or commit real values. Preserve private-key line breaks as escaped \n.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Server-only HMAC secret for irreversible public community author keys.
# Generate at least 32 random characters. Rotating it changes every public
# Guest-XXXX label and must be treated as a moderated identity migration.
COMMUNITY_IDENTITY_SECRET=

# Optional defense-in-depth for Firestore abuse. Configure a reCAPTCHA Enterprise
# App Check site key, monitor enforcement metrics first, and review its quota/pricing.
# Never use an App Check debug token in a public deployment.
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=

# Server-only. Never prefix this with NEXT_PUBLIC_ or expose it in browser code.
PINATA_JWT=
# Server-only gateway used to verify newly pinned creator media before a
# release can advance. Keep it independent from the browser display gateway.
CREATOR_IPFS_VERIFICATION_GATEWAY=https://ipfs.io/ipfs/
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/
# Protects scheduled media-availability checks. Use a distinct, high-entropy
# value and send it only as a server-side authorization header.
CRON_SECRET=
# Availability monitoring is a release gate. Keep it disabled until the
# scheduled worker and operator inbox have both been verified in staging.
CREATOR_MEDIA_MONITOR_ENABLED=false
CREATOR_MEDIA_MONITOR_MAX_RECEIPTS=8
