# Public release gate. Omit or set to "testnet" during development.
# Set to "mainnet" only after CI and the mainnet release checklist pass.
NEXT_PUBLIC_RMT_NETWORK=testnet

# Testnet-only override. Mainnet resolves its active factory through a version
# registry instead of trusting a browser-provided factory address.
NEXT_PUBLIC_FACTORY_ADDRESS=

# Mainnet V5 remains readable with the checked-in legacy registry and start block
# while this value is empty. Before V6 activation, set these to the newly deployed
# V6-governed registry and the exact block that deployed the V6 factory, then redeploy.
# /api/health publishes both values and V6 is unhealthy if either is absent or invalid.
NEXT_PUBLIC_VERSION_REGISTRY_ADDRESS=
NEXT_PUBLIC_FACTORY_START_BLOCK=

NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Use http://localhost:3000 for local work. Production must use the exact public
# HTTPS origin; the release console will not reopen from a preview or local origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Browser RPCs are public by definition. Use a production provider endpoint restricted
# to the RMT domains and set provider-side rate/spend limits; never expose an unrestricted key.
NEXT_PUBLIC_RMT_RPC_URL=
NEXT_PUBLIC_RMT_TESTNET_RPC_URL=

# Server-only archive-capable production RPC for feeds and health checks.
RMT_RPC_URL=
RMT_TESTNET_RPC_URL=

# Public support address shown on the Support page. Use a dedicated project inbox;
# never use a signer-wallet email or any address that receives recovery phrases.
NEXT_PUBLIC_RMT_SUPPORT_EMAIL=

# Server-only. Never prefix this with NEXT_PUBLIC_ or expose it in browser code.
PINATA_JWT=
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/
