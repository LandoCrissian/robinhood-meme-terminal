MARKET_INDEXER_DATABASE_URL=postgres://postgres:postgres@localhost:5432/rmt_market_indexer
MARKET_INDEXER_RPC_URL=https://rpc.mainnet.chain.robinhood.com/
MARKET_INDEXER_READ_TOKEN=replace-with-at-least-32-random-bytes
MARKET_INDEXER_STORAGE_MODE=durable
MARKET_INDEXER_MAX_DATABASE_MB=
MARKET_INDEXER_CONFIRMATIONS=20
MARKET_INDEXER_BATCH_SIZE=5000
MARKET_INDEXER_POLL_INTERVAL_MS=5000
MARKET_INDEXER_HEARTBEAT_INTERVAL_MS=60000
MARKET_INDEXER_DB_POOL_SIZE=5
PORT=3003
PGSSLMODE=verify-full

# Optional release-locked Position Guard evaluator. Both values must be set
# together. Reusing this private process avoids a second paid service. The token
# must exactly match the server-only Vercel value.
RMT_POSITION_GUARD_EVALUATOR_URL=
RMT_POSITION_GUARD_EVALUATOR_TOKEN=
RMT_POSITION_GUARD_EVALUATOR_INTERVAL_MS=5000
