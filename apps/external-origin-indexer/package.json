{
  "name": "external-origin-indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:shadow": "tsc -p tsconfig.shadow.json --noEmit",
    "test:schema": "tsx src/schema-smoke.ts",
    "test:api": "tsx src/api-smoke.ts",
    "test:candidates": "tsx src/candidates/bow-candidate-smoke.ts",
    "test:shadow-replay": "tsx shadow/bow-replay-smoke.ts"
  },
  "dependencies": {
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
