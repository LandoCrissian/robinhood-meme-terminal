# Required. Use a database dedicated to external-origin attribution.
# Never point this at the canonical RMT V6 indexer database.
EXTERNAL_ORIGIN_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Required. Store the real value only in the hosting provider and authorized
# server-side consumers. It must contain at least 32 characters.
EXTERNAL_ORIGIN_READ_TOKEN=replace-with-at-least-32-random-characters

EXTERNAL_ORIGIN_DB_POOL_SIZE=5
PORT=3002

# Use disable only for a local PostgreSQL instance without TLS.
PGSSLMODE=require
