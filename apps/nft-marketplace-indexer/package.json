{
  "name": "nft-marketplace-indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm test:unit && pnpm test:database",
    "test:unit": "tsx src/config-smoke.ts && tsx src/client-smoke.ts && tsx src/identity-smoke.ts && tsx src/normalization-smoke.ts",
    "test:database": "tsx src/storage-smoke.ts",
    "live-probe": "tsx src/live-probe.ts"
  },
  "dependencies": {
    "@rmt/shared": "workspace:*",
    "pg": "8.16.3",
    "viem": "2.55.5"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/pg": "8.15.5",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
