pragma solidity 0.8.26;
import {SeaportFixtureTypes as T,IFixtureSeaport,SeaportFixtureReceiver,SeaportFixtureSeller1271} from "./fixtures/SeaportFixtureReceiver.sol";
import {Acquisition721Fixture,Acquisition1155Fixture,AcquisitionCurrencyFixture} from "nft-acquisition-fixtures/NftAcquisitionAssets.sol";
interface VmSeaport {function projectRoot()external view returns(string memory);function readFile(string calldata)external view returns(string memory);function parseJsonBytes(string calldata,string calldata)external pure returns(bytes memory);function chainId(uint256)external;function deal(address,uint256)external;function addr(uint256)external returns(address);function sign(uint256,bytes32)external returns(uint8,bytes32,bytes32);function prank(address)external;function expectRevert()external;function warp(uint256)external;}
interface IFixtureConduitController {function createConduit(bytes32,address)external returns(address);function updateChannel(address,address,bool)external;}
contract OfficialSeaportTest {
 VmSeaport private constant vm=VmSeaport(address(uint160(uint256(keccak256("hevm cheat code")))));
 IFixtureSeaport public seaport;SeaportFixtureReceiver public receiver;Acquisition721Fixture public nft721;Acquisition1155Fixture public nft1155;AcquisitionCurrencyFixture public cash;
 address public seller;address payable private fee=payable(address(0xFEE));address payable private royalty=payable(address(0xBEEF));uint256 private constant SELLER_KEY=0xA11CE;
 function _deploy(bytes memory code)private returns(address result){assembly("memory-safe"){result:=create(0,add(code,32),mload(code))}require(result.code.length>0,"OFFICIAL_DEPLOYMENT");}
 function setUp()public {vm.chainId(31337);vm.warp(2_000_000_000);vm.deal(address(this),20 ether);seller=vm.addr(SELLER_KEY);string memory json=vm.readFile(string.concat(vm.projectRoot(),"/official-artifacts.json"));address controller=_deploy(vm.parseJsonBytes(json,".artifacts.ConduitController.creationCode"));seaport=IFixtureSeaport(_deploy(abi.encodePacked(vm.parseJsonBytes(json,".artifacts.Seaport.creationCode"),abi.encode(controller))));receiver=new SeaportFixtureReceiver(address(seaport));nft721=new Acquisition721Fixture(royalty,500);nft1155=new Acquisition1155Fixture(royalty,500);cash=new AcquisitionCurrencyFixture();(string memory version,bytes32 domain,address actual)=seaport.information();require(keccak256(bytes(version))==keccak256("1.6")&&actual==controller);require(domain==keccak256(abi.encode(keccak256("EIP712Domain(string name,string version,uint256 chainId,address verifyingContract)"),keccak256("Seaport"),keccak256("1.6"),block.chainid,address(seaport))));}
 function _order(bool multi,bool token,uint256 id)private returns(T.AdvancedOrder memory a){T.OfferItem[]memory offer=new T.OfferItem[](1);offer[0]=T.OfferItem(multi?3:2,multi?address(nft1155):address(nft721),id,multi?2:1,multi?2:1);T.ConsiderationItem[]memory consideration=new T.ConsiderationItem[](3);uint8 itemType=token?1:0;address currency=token?address(cash):address(0);consideration[0]=T.ConsiderationItem(itemType,currency,0,925e12,925e12,payable(seller));consideration[1]=T.ConsiderationItem(itemType,currency,0,25e12,25e12,fee);consideration[2]=T.ConsiderationItem(itemType,currency,0,50e12,50e12,royalty);a.parameters=T.OrderParameters(seller,address(0),offer,consideration,0,block.timestamp-1,block.timestamp+3600,bytes32(0),id,bytes32(0),3);a.numerator=1;a.denominator=1;(,bytes32 domain,)=seaport.information();bytes32 digest=keccak256(abi.encodePacked(hex"1901",domain,seaport.getOrderHash(_components(a))));(uint8 v,bytes32 r,bytes32 s)=vm.sign(SELLER_KEY,digest);a.signature=abi.encodePacked(r,s,v);}
 function _components(T.AdvancedOrder memory a)private view returns(T.OrderComponents memory){T.OrderParameters memory p=a.parameters;return T.OrderComponents(p.offerer,p.zone,p.offer,p.consideration,p.orderType,p.startTime,p.endTime,p.zoneHash,p.salt,p.conduitKey,seaport.getCounter(p.offerer));}
 function _mint(bool multi,uint256 id)private {if(multi){nft1155.mint(seller,id,3);vm.prank(seller);nft1155.setApprovalForAll(address(seaport),true);}else{nft721.mint(seller,id);vm.prank(seller);nft721.approve(address(seaport),id);}}
 function testActualERC721NativeFillAllRecipientsAndUnsafeTransferSemantics()public {_mint(false,1);T.AdvancedOrder memory a=_order(false,false,1);uint256 beforeSeller=seller.balance;receiver.fulfill{value:1e15}(a,address(0),1e15);require(nft721.ownerOf(1)==address(receiver));require(receiver.safe721Callbacks()==0,"Seaport uses transferFrom, not safeTransferFrom");require(seller.balance-beforeSeller==925e12&&fee.balance==25e12&&royalty.balance==50e12);(bool validated,bool cancelled,uint256 filled,uint256 size)=seaport.getOrderStatus(seaport.getOrderHash(_components(a)));require(validated&&!cancelled&&filled==size&&filled>0);vm.expectRevert();receiver.fulfill{value:1e15}(a,address(0),1e15);}
 function testActualERC1155NativeFillSafeCallbackAndQuantity()public {_mint(true,2);T.AdvancedOrder memory a=_order(true,false,2);receiver.fulfill{value:1e15}(a,address(0),1e15);require(nft1155.balanceOf(address(receiver),2)==2&&nft1155.balanceOf(seller,2)==1);require(receiver.safe1155Callbacks()==1&&seller.balance==925e12&&fee.balance==25e12&&royalty.balance==50e12);}
 function testActualERC20FillExactApprovalCleared()public {_mint(false,3);T.AdvancedOrder memory a=_order(false,true,3);cash.transfer(address(receiver),1e15);receiver.fulfill(a,address(cash),1e15);require(nft721.ownerOf(3)==address(receiver)&&cash.balanceOf(address(receiver))==0);require(cash.balanceOf(seller)==925e12&&cash.balanceOf(fee)==25e12&&cash.balanceOf(royalty)==50e12);require(cash.allowance(address(receiver),address(seaport))==0);}
 function testActualSellerCancellationBlocksFillAndPreservesAssets()public {_mint(false,4);T.AdvancedOrder memory a=_order(false,false,4);T.OrderComponents[]memory list=new T.OrderComponents[](1);list[0]=_components(a);vm.prank(seller);require(seaport.cancel(list));(,bool cancelled,,)=seaport.getOrderStatus(seaport.getOrderHash(list[0]));require(cancelled);vm.expectRevert();receiver.fulfill{value:1e15}(a,address(0),1e15);require(nft721.ownerOf(4)==seller&&seller.balance==0&&fee.balance==0);}
 function testCounterInvalidatesOriginalSignature()public {_mint(false,5);T.AdvancedOrder memory a=_order(false,false,5);vm.prank(seller);seaport.incrementCounter();vm.expectRevert();receiver.fulfill{value:1e15}(a,address(0),1e15);require(nft721.ownerOf(5)==seller);}
 function testFeeOrRoyaltySubstitutionInvalidatesSellerSignature()public {_mint(false,6);T.AdvancedOrder memory a=_order(false,false,6);a.parameters.consideration[2].recipient=payable(address(0xBAD));vm.expectRevert();receiver.fulfill{value:1e15}(a,address(0),1e15);require(nft721.ownerOf(6)==seller&&fee.balance==0&&royalty.balance==0);}
 function testWrongChainRejectsSignature()public {_mint(false,7);T.AdvancedOrder memory a=_order(false,false,7);vm.chainId(4663);vm.expectRevert();seaport.fulfillAdvancedOrder{value:1e15}(a,new T.CriteriaResolver[](0),bytes32(0),address(receiver));vm.chainId(31337);require(nft721.ownerOf(7)==seller);}
 function testExpiredOrPartialAndInsufficientValueFailWithoutSettlement()public {_mint(true,8);T.AdvancedOrder memory a=_order(true,false,8);a.numerator=1;a.denominator=2;vm.expectRevert();receiver.fulfill{value:1e15}(a,address(0),1e15);a.denominator=1;vm.expectRevert();receiver.fulfill{value:1e15-1}(a,address(0),1e15);vm.warp(block.timestamp+3601);vm.expectRevert();receiver.fulfill{value:1e15}(a,address(0),1e15);require(nft1155.balanceOf(seller,8)==3&&fee.balance==0);}
 function testSellerTransferBeforeFillRollsBackEveryPayment()public {_mint(false,9);T.AdvancedOrder memory a=_order(false,false,9);vm.prank(seller);nft721.transferFrom(seller,address(0xABCD),9);vm.expectRevert();receiver.fulfill{value:1e15}(a,address(0),1e15);require(nft721.ownerOf(9)==address(0xABCD)&&seller.balance==0&&fee.balance==0&&royalty.balance==0);}
 function testFuzzWrongAllInCapAlwaysReverts(uint128 proposed)public {_mint(false,10);T.AdvancedOrder memory a=_order(false,false,10);if(proposed==1e15)return;vm.expectRevert();receiver.fulfill{value:1e15}(a,address(0),proposed);require(nft721.ownerOf(10)==seller&&seller.balance==0);}
 function _resign(T.AdvancedOrder memory a)private returns(T.AdvancedOrder memory){(,bytes32 domain,)=seaport.information();bytes32 digest=keccak256(abi.encodePacked(hex"1901",domain,seaport.getOrderHash(_components(a))));(uint8 v,bytes32 r,bytes32 t)=vm.sign(SELLER_KEY,digest);a.signature=abi.encodePacked(r,t,v);return a;}
 function testActual1271SellerAndNativeCallbackCannotReenterSeaport()public {SeaportFixtureSeller1271 wallet=new SeaportFixtureSeller1271(seller,address(seaport));nft721.mint(address(wallet),11);vm.prank(seller);wallet.approve721(address(nft721),11);vm.prank(seller);wallet.configure(false,true);T.AdvancedOrder memory a=_order(false,false,11);a.parameters.offerer=address(wallet);a.parameters.consideration[0].recipient=payable(address(wallet));a=_resign(a);receiver.fulfill{value:1e15}(a,address(0),1e15);require(nft721.ownerOf(11)==address(receiver)&&address(wallet).balance==925e12);require(!wallet.reentrySucceeded()&&seaport.getCounter(address(wallet))==0);}
 function testActual1271WrongMagicRejectsAndKeepsNft()public {SeaportFixtureSeller1271 wallet=new SeaportFixtureSeller1271(seller,address(seaport));nft721.mint(address(wallet),12);vm.prank(seller);wallet.approve721(address(nft721),12);vm.prank(seller);wallet.configure(true,false);T.AdvancedOrder memory a=_order(false,false,12);a.parameters.offerer=address(wallet);a.parameters.consideration[0].recipient=payable(address(wallet));a=_resign(a);vm.expectRevert();receiver.fulfill{value:1e15}(a,address(0),1e15);require(nft721.ownerOf(12)==address(wallet)&&address(wallet).balance==0&&fee.balance==0);}
 function testActualConduitRequiresCreatorApprovalAndOpenChannel()public {(,,address controller)=seaport.information();bytes32 key=bytes32((uint256(uint160(seller))<<96)|1);vm.prank(seller);address conduit=IFixtureConduitController(controller).createConduit(key,seller);nft721.mint(seller,13);vm.prank(seller);nft721.approve(conduit,13);T.AdvancedOrder memory a=_order(false,false,13);a.parameters.conduitKey=key;a=_resign(a);vm.expectRevert();seaport.fulfillAdvancedOrder{value:1e15}(a,new T.CriteriaResolver[](0),bytes32(0),address(receiver));require(nft721.ownerOf(13)==seller&&fee.balance==0);vm.prank(seller);IFixtureConduitController(controller).updateChannel(conduit,address(seaport),true);require(seaport.fulfillAdvancedOrder{value:1e15}(a,new T.CriteriaResolver[](0),bytes32(0),address(receiver)));require(nft721.ownerOf(13)==address(receiver)&&seller.balance==925e12&&fee.balance==25e12&&royalty.balance==50e12);}
 function testActualERC20InsufficientReserveRevertsAllConsideration()public {_mint(false,14);T.AdvancedOrder memory a=_order(false,true,14);cash.transfer(address(receiver),1e15-1);vm.expectRevert();receiver.fulfill(a,address(cash),1e15);require(nft721.ownerOf(14)==seller&&cash.balanceOf(seller)==0&&cash.balanceOf(fee)==0&&cash.balanceOf(royalty)==0&&cash.allowance(address(receiver),address(seaport))==0);}
 function testActualMalformedNftDeliveryRevertsInsteadOfReportingCustody()public {_mint(true,15);nft1155.configureFault(1,address(0xBAD));T.AdvancedOrder memory a=_order(true,false,15);vm.expectRevert();receiver.fulfill{value:1e15}(a,address(0),1e15);require(nft1155.balanceOf(seller,15)==3&&nft1155.balanceOf(address(0xBAD),15)==0&&fee.balance==0);}
 function testActualPartialOpenFractionIsObservableAndNotTheAdmittedFullSubset()public {nft1155.mint(seller,16,4);vm.prank(seller);nft1155.setApprovalForAll(address(seaport),true);T.AdvancedOrder memory a=_order(true,false,16);a.parameters.offer[0].startAmount=4;a.parameters.offer[0].endAmount=4;a.parameters.orderType=1;a.numerator=1;a.denominator=2;a=_resign(a);require(seaport.fulfillAdvancedOrder{value:5e14}(a,new T.CriteriaResolver[](0),bytes32(0),address(0xCAFE)));require(nft1155.balanceOf(address(0xCAFE),16)==2&&nft1155.balanceOf(seller,16)==2);(bool validated,bool cancelled,uint256 filled,uint256 size)=seaport.getOrderStatus(seaport.getOrderHash(_components(a)));require(validated&&!cancelled&&filled>0&&size==filled*2);}
}
