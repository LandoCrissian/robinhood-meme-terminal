{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "scripts/visual-qa/legion-token-fixture-authority-smoke.ts",
    "packages/contracts/scripts/export-consent-testnet-web-artifacts.mjs",
    "packages/contracts/scripts/export-mainnet-web-artifacts.mjs",
    "packages/contracts/scripts/export-testnet-web-artifacts.mjs"
  ],
  "workspaces": {
    ".": {
      "entry": [
        ".github/scripts/zerox-browser-boundary.cjs",
        ".github/scripts/zerox-execution-fixture.cjs",
        ".github/scripts/collect-live-journey-proof.cjs",
        ".github/scripts/live-journey-runtime-proof.cjs",
        "packages/contracts/scripts/build-launch-4663-review.mjs",
        "packages/contracts/scripts/validate-launch-4663-fork.mjs"
      ]
    },
    "apps/web": {
      "entry": [
        "app/**/*.{ts,tsx}",
        "lib/testing/**/*.{ts,tsx}",
        "lib/**/*-smoke.ts",
        "lib/**/*.test.ts",
        "scripts/launch-4663-public-evidence.ts",
        "scripts/new-launchpad-backup.ts",
        "scripts/curve-launch-backup.ts",
        "scripts/probe-robinhood-launch-readiness.ts"
      ]
    },
    "apps/indexer": {
      "entry": [
        "src/**/*-smoke.ts"
      ],
      "ignoreDependencies": ["tsx"]
    },
    "apps/external-origin-indexer": {
      "entry": [
        "src/**/*-smoke.ts",
        "shadow/**/*-smoke.ts"
      ],
      "ignoreDependencies": ["tsx"]
    },
    "apps/market-indexer": {
      "entry": [
        "src/**/*-smoke.ts"
      ],
      "ignoreDependencies": ["tsx"]
    }
  }
}
