rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsProfile(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validProfile(data) {
      return data is map
        && data.keys().hasOnly(['displayName', 'handle', 'bio', 'traderMode', 'density'])
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 40
        && data.handle is string && data.handle.size() <= 24
        && data.bio is string && data.bio.size() <= 180
        && data.traderMode in ['scout', 'momentum', 'builder']
        && data.density in ['focused', 'compact'];
    }

    function validUserDocument() {
      return request.resource.data.keys().hasOnly(['profile', 'watchlist', 'email', 'updatedAt'])
        && validProfile(request.resource.data.profile)
        && request.resource.data.watchlist is list
        && request.resource.data.watchlist.size() <= 50
        && (request.resource.data.email == null || request.resource.data.email is string)
        && request.resource.data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow read, delete: if ownsProfile(userId);
      allow create, update: if ownsProfile(userId) && validUserDocument();
    }
  }
}
