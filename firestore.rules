rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsProfile(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email_verified == true;
    }

    function hasProfile(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function hasProtectedProfile(userId) {
      return hasProfile(userId)
        && get(/databases/$(database)/documents/users/$(userId)).data.get('identityUpdatedAt', 0)
          is timestamp;
    }

    function isRmtAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'launchrmt@gmail.com';
    }

    function validProfile(data) {
      return data is map
        && data.keys().hasAll(['displayName', 'handle', 'bio', 'traderMode', 'density'])
        && data.keys().hasOnly(['displayName', 'handle', 'bio', 'traderMode', 'density'])
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 40
        && data.handle is string && data.handle.matches('^[a-zA-Z0-9_]{0,24}$')
        && data.bio is string && data.bio.size() <= 180
        && data.traderMode in ['scout', 'momentum', 'builder']
        && data.density in ['focused', 'compact'];
    }

    function validUserDocument(data) {
      let identityUpdatedAt = data.get('identityUpdatedAt', 0);
      return data.keys().hasAll([
          'schemaVersion',
          'profile',
          'profileUpdatedAt',
          'watchlistCount',
          'watchlistUpdatedAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'schemaVersion',
          'profile',
          'profileUpdatedAt',
          'identityUpdatedAt',
          'watchlistCount',
          'watchlistUpdatedAt',
          'updatedAt'
        ])
        && data.schemaVersion == 1
        && validProfile(data.profile)
        && data.profileUpdatedAt is int && data.profileUpdatedAt > 0
        && (identityUpdatedAt == 0 || identityUpdatedAt is timestamp)
        && data.watchlistCount is int && data.watchlistCount >= 0 && data.watchlistCount <= 50
        && data.watchlistUpdatedAt is int && data.watchlistUpdatedAt > 0
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function validUserUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let identityChanged = request.resource.data.profile.displayName != resource.data.profile.displayName
        || request.resource.data.profile.handle != resource.data.profile.handle
        || request.resource.data.profile.bio != resource.data.profile.bio;
      let previousIdentityUpdate = resource.data.get('identityUpdatedAt', 0);
      let nextIdentityUpdate = request.resource.data.get('identityUpdatedAt', 0);
      return request.resource.data.profileUpdatedAt >= resource.data.get('profileUpdatedAt', 0)
        && request.resource.data.watchlistUpdatedAt >= resource.data.get('watchlistUpdatedAt', 0)
        && (!changed.hasAny(['profile'])
          || changed.hasAny(['profileUpdatedAt']))
        && (!changed.hasAny(['watchlistCount'])
          || changed.hasAny(['watchlistUpdatedAt']))
        && (identityChanged
          ? nextIdentityUpdate == request.time
            && (previousIdentityUpdate == 0
              || (previousIdentityUpdate is timestamp
                && (request.time <= previousIdentityUpdate + duration.value(10, 'm')
                  || request.time >= previousIdentityUpdate + duration.value(24, 'h'))))
          : nextIdentityUpdate == previousIdentityUpdate);
    }

    function validWatchlistEntry(slotId, data) {
      let image = data.get('image', '');
      let launchId = data.get('launchId', '');
      return slotId.matches('^(0[0-9]|[1-4][0-9])$')
        && data.keys().hasAll(['address', 'name', 'symbol', 'addedAt', 'listUpdatedAt'])
        && data.keys().hasOnly(['address', 'name', 'symbol', 'image', 'launchId', 'addedAt', 'listUpdatedAt'])
        && data.address is string && data.address.matches('^0x[0-9a-f]{40}$')
        && data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && data.symbol is string && data.symbol.size() > 0 && data.symbol.size() <= 20
        && image is string && image.size() <= 512
        && (image == '' || image.matches('^(https://|ipfs://).+$'))
        && launchId is string && launchId.size() <= 78
        && (launchId == '' || launchId.matches('^[0-9]+$'))
        && data.addedAt is int && data.addedAt > 0
        && data.listUpdatedAt is int && data.listUpdatedAt > 0;
    }

    function watchlistMatchesParent(userId, data) {
      return getAfter(/databases/$(database)/documents/users/$(userId)).data.watchlistUpdatedAt
        == data.listUpdatedAt;
    }

    function validProjectType(value) {
      return value in ['token', 'art', 'music', 'gaming', 'community', 'other'];
    }

    function validProjectModules(value) {
      return value is list
        && value.size() > 0 && value.size() <= 5
        && value.hasOnly(['token', 'nft', 'marketplace', 'music', 'game']);
    }

    function validCreatorApplication(data) {
      let reviewNote = data.get('reviewNote', '');
      let projectSlug = data.get('projectSlug', '');
      return data.keys().hasAll([
          'schemaVersion',
          'projectName',
          'summary',
          'projectType',
          'website',
          'xProfile',
          'tokenAddress',
          'requestedModules',
          'ownershipConfirmed',
          'termsAccepted',
          'contactEmail',
          'status',
          'submittedAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'schemaVersion',
          'projectName',
          'summary',
          'projectType',
          'website',
          'xProfile',
          'tokenAddress',
          'requestedModules',
          'ownershipConfirmed',
          'termsAccepted',
          'contactEmail',
          'status',
          'submittedAt',
          'updatedAt',
          'reviewedAt',
          'reviewNote',
          'projectSlug'
        ])
        && data.schemaVersion == 1
        && data.projectName is string && data.projectName.size() >= 2 && data.projectName.size() <= 80
        && data.summary is string && data.summary.size() >= 40 && data.summary.size() <= 600
        && validProjectType(data.projectType)
        && data.website is string && data.website.size() <= 256
        && (data.website == '' || data.website.matches('^https://.+$'))
        && data.xProfile is string && data.xProfile.size() <= 256
        && (data.xProfile == '' || data.xProfile.matches('^https://.+$'))
        && data.tokenAddress is string
        && (data.tokenAddress == '' || data.tokenAddress.matches('^0x[0-9a-f]{40}$'))
        && validProjectModules(data.requestedModules)
        && (!data.requestedModules.hasAny(['token']) || data.tokenAddress != '')
        && data.ownershipConfirmed == true
        && data.termsAccepted == true
        && data.contactEmail is string && data.contactEmail.size() >= 3 && data.contactEmail.size() <= 254
        && data.status in ['pending', 'needs_changes', 'approved', 'rejected']
        && data.submittedAt is timestamp
        && data.updatedAt is timestamp
        && reviewNote is string && reviewNote.size() <= 600
        && projectSlug is string && projectSlug.size() <= 48
        && (projectSlug == '' || projectSlug.matches('^[a-z0-9][a-z0-9-]{1,46}[a-z0-9]$'));
    }

    function validApplicationCreate(userId) {
      return ownsProfile(userId)
        && hasProfile(userId)
        && request.resource.data.contactEmail == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.submittedAt == request.time
        && request.resource.data.updatedAt == request.time
        && !request.resource.data.keys().hasAny(['reviewedAt', 'reviewNote', 'projectSlug']);
    }

    function validApplicationResubmission(userId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return ownsProfile(userId)
        && hasProfile(userId)
        && resource.data.status == 'needs_changes'
        && request.resource.data.status == 'pending'
        && request.resource.data.contactEmail == resource.data.contactEmail
        && request.resource.data.submittedAt == resource.data.submittedAt
        && request.resource.data.updatedAt == request.time
        && !request.resource.data.keys().hasAny(['reviewedAt', 'reviewNote', 'projectSlug'])
        && changed.hasOnly([
          'projectName',
          'summary',
          'projectType',
          'website',
          'xProfile',
          'tokenAddress',
          'requestedModules',
          'ownershipConfirmed',
          'termsAccepted',
          'status',
          'updatedAt',
          'reviewedAt',
          'reviewNote',
          'projectSlug'
        ]);
    }

    function validAdminReview() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let note = request.resource.data.get('reviewNote', '');
      let slug = request.resource.data.get('projectSlug', '');
      return isRmtAdmin()
        && resource.data.status in ['pending', 'needs_changes']
        && request.resource.data.status in ['needs_changes', 'approved', 'rejected']
        && (request.resource.data.status != 'approved' || resource.data.status == 'pending')
        && request.resource.data.submittedAt == resource.data.submittedAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.reviewedAt == request.time
        && changed.hasOnly(['status', 'reviewNote', 'reviewedAt', 'updatedAt', 'projectSlug'])
        && (request.resource.data.status == 'approved'
          ? slug.size() >= 3
          : note.size() >= 10 && slug == '');
    }

    function validGameMediaUri(value) {
      return value is string
        && value.size() > 0
        && value.size() <= 512
        && value.matches('^(https://|ipfs://).+$');
    }

    function validGameMediaUris(value) {
      return value is list
        && value.size() <= 6
        && (value.size() < 1 || validGameMediaUri(value[0]))
        && (value.size() < 2 || validGameMediaUri(value[1]))
        && (value.size() < 3 || validGameMediaUri(value[2]))
        && (value.size() < 4 || validGameMediaUri(value[3]))
        && (value.size() < 5 || validGameMediaUri(value[4]))
        && (value.size() < 6 || validGameMediaUri(value[5]));
    }

    function validPublicProject(projectId, data) {
      let logoUri = data.get('logoUri', '');
      let bannerUri = data.get('bannerUri', '');
      let gameUrl = data.get('gameUrl', '');
      let trailerUrl = data.get('trailerUrl', '');
      let gameStatus = data.get('gameStatus', '');
      let gamePlatforms = data.get('gamePlatforms', []);
      let gameGenre = data.get('gameGenre', '');
      let gameModes = data.get('gameModes', []);
      let gameReleaseDate = data.get('gameReleaseDate', '');
      let gameMediaUris = data.get('gameMediaUris', []);
      let gameEnabled = data.projectType == 'gaming' || data.availableModules.hasAny(['game']);
      return data.keys().hasAll([
          'schemaVersion',
          'slug',
          'name',
          'summary',
          'projectType',
          'website',
          'xProfile',
          'tokenAddress',
          'availableModules',
          'status',
          'publishedAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'schemaVersion',
          'slug',
          'name',
          'summary',
          'projectType',
          'website',
          'xProfile',
          'logoUri',
          'bannerUri',
          'gameUrl',
          'trailerUrl',
          'gameStatus',
          'gamePlatforms',
          'gameGenre',
          'gameModes',
          'gameReleaseDate',
          'gameMediaUris',
          'tokenAddress',
          'availableModules',
          'status',
          'publishedAt',
          'updatedAt'
        ])
        && data.schemaVersion == 1
        && data.slug == projectId
        && data.slug.matches('^[a-z0-9][a-z0-9-]{1,46}[a-z0-9]$')
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && data.summary is string && data.summary.size() >= 40 && data.summary.size() <= 600
        && validProjectType(data.projectType)
        && data.website is string && data.website.size() <= 256
        && (data.website == '' || data.website.matches('^https://.+$'))
        && data.xProfile is string && data.xProfile.size() <= 256
        && (data.xProfile == '' || data.xProfile.matches('^https://.+$'))
        && logoUri is string && logoUri.size() <= 512
        && (logoUri == '' || logoUri.matches('^(https://|ipfs://).+$'))
        && bannerUri is string && bannerUri.size() <= 512
        && (bannerUri == '' || bannerUri.matches('^(https://|ipfs://).+$'))
        && gameUrl is string && gameUrl.size() <= 256
        && (gameUrl == '' || gameUrl.matches('^https://.+$'))
        && trailerUrl is string && trailerUrl.size() <= 256
        && (trailerUrl == '' || trailerUrl.matches('^https://.+$'))
        && gameStatus is string
        && gamePlatforms is list && gamePlatforms.size() <= 7
        && gamePlatforms.hasOnly(['web', 'windows', 'macos', 'ios', 'android', 'console', 'vr'])
        && gameGenre is string
        && gameModes is list && gameModes.size() <= 5
        && gameModes.hasOnly(['single-player', 'multiplayer', 'co-op', 'competitive', 'mmo'])
        && gameReleaseDate is string && gameReleaseDate.size() <= 10
        && (gameReleaseDate == '' || gameReleaseDate.matches('^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[0-1])$'))
        && validGameMediaUris(gameMediaUris)
        && (gameEnabled
          ? gameStatus in ['concept', 'development', 'playable', 'live']
            && (gameGenre == '' || gameGenre in ['action', 'adventure', 'arcade', 'card', 'casual', 'fighting', 'puzzle', 'racing', 'rpg', 'simulation', 'sports', 'strategy', 'other'])
          : gameUrl == ''
            && trailerUrl == ''
            && gameStatus == ''
            && gamePlatforms.size() == 0
            && gameGenre == ''
            && gameModes.size() == 0
            && gameReleaseDate == ''
            && gameMediaUris.size() == 0)
        && data.tokenAddress is string
        && (data.tokenAddress == '' || data.tokenAddress.matches('^0x[0-9a-f]{40}$'))
        && validProjectModules(data.availableModules)
        && (!data.availableModules.hasAny(['token']) || data.tokenAddress != '')
        && data.status == 'live'
        && data.publishedAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validCreatorProjectIdentityUpdate(projectId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return ownsProjectAssignment(projectId)
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.slug == resource.data.slug
        && request.resource.data.projectType == resource.data.projectType
        && request.resource.data.tokenAddress == resource.data.tokenAddress
        && request.resource.data.availableModules == resource.data.availableModules
        && request.resource.data.status == resource.data.status
        && request.resource.data.publishedAt == resource.data.publishedAt
        && request.resource.data.updatedAt == request.time
        && changed.hasOnly([
          'name',
          'summary',
          'website',
          'xProfile',
          'logoUri',
          'bannerUri',
          'gameUrl',
          'trailerUrl',
          'gameStatus',
          'gamePlatforms',
          'gameGenre',
          'gameModes',
          'gameReleaseDate',
          'gameMediaUris',
          'updatedAt'
        ]);
    }

    function validGameUpdate(data) {
      let version = data.get('version', '');
      let link = data.get('link', '');
      let imageUri = data.get('imageUri', '');
      return data.keys().hasAll([
          'schemaVersion',
          'type',
          'title',
          'body',
          'version',
          'link',
          'imageUri',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'schemaVersion',
          'type',
          'title',
          'body',
          'version',
          'link',
          'imageUri',
          'createdAt',
          'updatedAt'
        ])
        && data.schemaVersion == 1
        && data.type in ['development', 'milestone', 'playtest', 'release']
        && data.title is string && data.title.size() >= 4 && data.title.size() <= 80
        && data.body is string && data.body.size() >= 20 && data.body.size() <= 600
        && version is string && version.size() <= 24
        && link is string && link.size() <= 256
        && (link == '' || link.matches('^https://.+$'))
        && imageUri is string && imageUri.size() <= 512
        && (imageUri == '' || imageUri.matches('^(https://|ipfs://).+$'))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function projectHasGameModule(projectId) {
      let project = get(/databases/$(database)/documents/projects/$(projectId)).data;
      return project.status == 'live'
        && (project.projectType == 'gaming' || project.availableModules.hasAny(['game']));
    }

    function validProjectFollow(projectId, data) {
      return data.keys().hasAll(['schemaVersion', 'projectSlug', 'followedAt'])
        && data.keys().hasOnly(['schemaVersion', 'projectSlug', 'followedAt'])
        && data.schemaVersion == 1
        && data.projectSlug == projectId
        && data.projectSlug.matches('^[a-z0-9][a-z0-9-]{1,46}[a-z0-9]$')
        && data.followedAt is timestamp;
    }

    function validProjectStats(projectId, data) {
      return data.keys().hasAll([
          'schemaVersion',
          'projectSlug',
          'followerCount',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'schemaVersion',
          'projectSlug',
          'followerCount',
          'updatedAt'
        ])
        && data.schemaVersion == 1
        && data.projectSlug == projectId
        && data.projectSlug.matches('^[a-z0-9][a-z0-9-]{1,46}[a-z0-9]$')
        && data.followerCount is int
        && data.followerCount >= 0
        && data.updatedAt is timestamp;
    }

    function validReferralCode(code, data) {
      return code.matches('^RMT-[A-HJ-NP-Z2-9]{8}$')
        && data.keys().hasAll([
          'schemaVersion',
          'code',
          'ownerId',
          'verifiedActivations',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'schemaVersion',
          'code',
          'ownerId',
          'verifiedActivations',
          'createdAt',
          'updatedAt'
        ])
        && data.schemaVersion == 1
        && data.code == code
        && data.ownerId is string && data.ownerId.size() > 0 && data.ownerId.size() <= 128
        && data.verifiedActivations is int && data.verifiedActivations >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validReferralProfile(data) {
      return data.keys().hasAll(['schemaVersion', 'code', 'createdAt'])
        && data.keys().hasOnly(['schemaVersion', 'code', 'createdAt'])
        && data.schemaVersion == 1
        && data.code is string && data.code.matches('^RMT-[A-HJ-NP-Z2-9]{8}$')
        && data.createdAt is timestamp;
    }

    function validReferralClaim(data) {
      return data.keys().hasAll(['schemaVersion', 'code', 'claimedAt'])
        && data.keys().hasOnly(['schemaVersion', 'code', 'claimedAt'])
        && data.schemaVersion == 1
        && data.code is string && data.code.matches('^RMT-[A-HJ-NP-Z2-9]{8}$')
        && data.claimedAt is timestamp;
    }

    function referralProfileCreatesCode(userId, code) {
      let codePath = /databases/$(database)/documents/referralCodes/$(code);
      return existsAfter(codePath)
        && getAfter(codePath).data.ownerId == userId
        && getAfter(codePath).data.verifiedActivations == 0;
    }

    function referralClaimAddsActivation(userId, code) {
      let codePath = /databases/$(database)/documents/referralCodes/$(code);
      return exists(codePath)
        && get(codePath).data.ownerId != userId
        && existsAfter(codePath)
        && getAfter(codePath).data.verifiedActivations
          == get(codePath).data.verifiedActivations + 1;
    }

    function followAddsOneToStats(projectId) {
      let statsPath = /databases/$(database)/documents/projectStats/$(projectId);
      return existsAfter(statsPath)
        && getAfter(statsPath).data.followerCount
          == (exists(statsPath) ? get(statsPath).data.followerCount + 1 : 1);
    }

    function followRemovesOneFromStats(projectId) {
      let statsPath = /databases/$(database)/documents/projectStats/$(projectId);
      return exists(statsPath)
        && existsAfter(statsPath)
        && get(statsPath).data.followerCount > 0
        && getAfter(statsPath).data.followerCount == get(statsPath).data.followerCount - 1;
    }

    function validProjectAssignment(projectId, data) {
      return data.keys().hasAll([
          'schemaVersion',
          'projectSlug',
          'ownerId',
          'allowedModules',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'schemaVersion',
          'projectSlug',
          'ownerId',
          'allowedModules',
          'createdAt',
          'updatedAt'
        ])
        && data.schemaVersion == 1
        && data.projectSlug == projectId
        && data.projectSlug.matches('^[a-z0-9][a-z0-9-]{1,46}[a-z0-9]$')
        && data.ownerId is string && data.ownerId.size() > 0 && data.ownerId.size() <= 128
        && validProjectModules(data.allowedModules)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function ownsProjectAssignment(projectId) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && get(/databases/$(database)/documents/projectAssignments/$(projectId)).data.ownerId
          == request.auth.uid;
    }

    function validModuleActivationRequest(module, data) {
      let reviewNote = data.get('reviewNote', '');
      return module in ['token', 'nft', 'marketplace', 'music', 'game']
        && data.keys().hasAll([
          'schemaVersion',
          'module',
          'status',
          'requestedAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'schemaVersion',
          'module',
          'status',
          'requestedAt',
          'updatedAt',
          'reviewedAt',
          'reviewNote'
        ])
        && data.schemaVersion == 1
        && data.module == module
        && data.status in ['requested', 'reviewing', 'ready', 'declined']
        && data.requestedAt is timestamp
        && data.updatedAt is timestamp
        && reviewNote is string && reviewNote.size() <= 600;
    }

    function validCreatorAssetMedia(value, optional) {
      return value is string
        && value.size() <= 512
        && ((optional && value == '') || value.matches('^(https://|ipfs://).+$'));
    }

    function validCreatorAsset(assetId, projectId, data) {
      let aiDisclosure = data.get('aiDisclosure', '');
      let licenseUri = data.get('licenseUri', '');
      return assetId.matches('^[A-Za-z0-9]{20}$')
        && data.keys().hasOnly([
          'schemaVersion',
          'assetId',
          'projectSlug',
          'assetType',
          'title',
          'description',
          'primaryMediaUri',
          'previewMediaUri',
          'creationMethod',
          'aiTools',
          'aiDisclosure',
          'rightsBasis',
          'rightsStatement',
          'rightsConfirmed',
          'containsThirdPartyMaterial',
          'thirdPartyRightsConfirmed',
          'license',
          'licenseUri',
          'secondaryRoyaltyBps',
          'editionMode',
          'editionSupply',
          'musicReleaseType',
          'explicitContent',
          'masterRightsConfirmed',
          'compositionRightsConfirmed',
          'collaborators',
          'collaboratorConsentStatus',
          'revenueSplits',
          'revenueSplitTotalBps',
          'draftRevisionHash',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.schemaVersion == 1
        && data.assetId == assetId
        && data.projectSlug == projectId
        && data.assetType in ['artwork', 'music_release', 'nft_collection']
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 100
        && data.description is string && data.description.size() >= 20 && data.description.size() <= 1200
        && validCreatorAssetMedia(data.primaryMediaUri, false)
        && validCreatorAssetMedia(data.previewMediaUri, true)
        && data.creationMethod in ['human', 'ai_assisted', 'ai_generated']
        && data.aiTools is list && data.aiTools.size() <= 8
        && aiDisclosure is string && aiDisclosure.size() <= 600
        && (data.creationMethod == 'human'
          ? data.aiTools.size() == 0 && aiDisclosure == ''
          : data.aiTools.size() > 0 && aiDisclosure.size() >= 20)
        && data.rightsBasis in ['original', 'commissioned', 'licensed', 'public_domain']
        && data.rightsStatement is string
        && data.rightsStatement.size() >= 20 && data.rightsStatement.size() <= 1000
        && data.rightsConfirmed == true
        && data.containsThirdPartyMaterial is bool
        && data.thirdPartyRightsConfirmed is bool
        && (!data.containsThirdPartyMaterial || data.thirdPartyRightsConfirmed)
        && data.license in ['all_rights_reserved', 'personal_use', 'commercial_use', 'cc0', 'cc_by', 'custom']
        && licenseUri is string && licenseUri.size() <= 512
        && (data.license == 'custom' ? licenseUri.matches('^https://.+$') : licenseUri == '')
        && data.secondaryRoyaltyBps is int
        && data.secondaryRoyaltyBps >= 0 && data.secondaryRoyaltyBps <= 1000
        && data.editionMode in ['one_of_one', 'limited', 'open']
        && data.editionSupply is int
        && (data.editionMode == 'one_of_one'
          ? data.editionSupply == 1
          : data.editionMode == 'open'
            ? data.editionSupply == 0
            : data.editionSupply >= 1 && data.editionSupply <= 1000000)
        && data.musicReleaseType in ['single', 'ep', 'album']
        && data.explicitContent is bool
        && data.masterRightsConfirmed is bool
        && data.compositionRightsConfirmed is bool
        && (data.assetType == 'music_release'
          ? data.masterRightsConfirmed && data.compositionRightsConfirmed
          : !data.explicitContent && !data.masterRightsConfirmed && !data.compositionRightsConfirmed)
        && data.collaborators is list && data.collaborators.size() <= 6
        && data.collaboratorConsentStatus == 'unverified'
        && data.revenueSplits is list && data.revenueSplits.size() <= 5
        && data.revenueSplitTotalBps is int
        && (data.revenueSplits.size() == 0
          ? data.revenueSplitTotalBps == 0
          : data.revenueSplitTotalBps == 10000)
        && data.draftRevisionHash.matches('^0x[0-9a-f]{64}$')
        && data.status == 'draft'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function projectAssignmentAllowsAsset(projectId, assetType) {
      let modules = get(/databases/$(database)/documents/projectAssignments/$(projectId)).data.allowedModules;
      return assetType == 'music_release'
        ? modules.hasAny(['music'])
        : modules.hasAny(['nft']);
    }

    function validCreatorConsentInvitation(invitationId, projectId, assetId, data) {
      return invitationId.matches('^[0-9a-f]{64}$')
        && data.keys().hasOnly([
          'schemaVersion',
          'invitationId',
          'invitationDigest',
          'projectSlug',
          'assetId',
          'draftRevisionHash',
          'collaboratorName',
          'collaboratorRole',
          'collaboratorWallet',
          'shareBps',
          'chainId',
          'expiresAt',
          'termsHash',
          'nonce',
          'status',
          'revokedAt',
          'responseAction',
          'responseSignature',
          'respondedAt',
          'signerWallet',
          'receivedAt',
          'withdrawalSignature',
          'withdrawalSignedAt',
          'withdrawalReceivedAt',
          'createdAt',
          'updatedAt'
        ])
        && data.schemaVersion == 1
        && data.invitationId == invitationId
        && data.invitationDigest == '0x' + invitationId
        && data.projectSlug == projectId
        && data.assetId == assetId
        && data.draftRevisionHash.matches('^0x[0-9a-f]{64}$')
        && data.collaboratorName is string
        && data.collaboratorName.size() >= 2 && data.collaboratorName.size() <= 60
        && data.collaboratorRole in ['artist', 'producer', 'songwriter', 'performer', 'developer', 'label', 'publisher', 'other']
        && data.collaboratorWallet.matches('^0x[0-9a-f]{40}$')
        && data.shareBps is int && data.shareBps >= 0 && data.shareBps <= 10000
        && data.chainId is int && data.chainId > 0
        && data.expiresAt is int && data.expiresAt > 0
        && data.termsHash.matches('^0x[0-9a-f]{64}$')
        && data.nonce.matches('^0x[0-9a-f]{64}$')
        && data.status in ['pending', 'revoked']
        && ((data.status == 'pending' && data.revokedAt == null)
          || (data.status == 'revoked' && data.revokedAt is timestamp))
        && data.get('responseAction', null) == null
        && data.get('responseSignature', null) == null
        && data.get('respondedAt', null) == null
        && data.get('signerWallet', null) == null
        && data.get('receivedAt', null) == null
        && data.get('withdrawalSignature', null) == null
        && data.get('withdrawalSignedAt', null) == null
        && data.get('withdrawalReceivedAt', null) == null
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validCreatorConsentPublicStatus(invitationId, data) {
      return invitationId.matches('^[0-9a-f]{64}$')
        && data.keys().hasOnly([
          'schemaVersion',
          'invitationId',
          'invitationDigest',
          'projectSlug',
          'assetId',
          'status',
          'expiresAt',
          'createdAt',
          'updatedAt'
        ])
        && data.schemaVersion == 1
        && data.invitationId == invitationId
        && data.invitationDigest == '0x' + invitationId
        && data.projectSlug.matches('^[a-z0-9]+(?:-[a-z0-9]+)*$')
        && data.assetId.matches('^[A-Za-z0-9]{20}$')
        && data.status in ['pending', 'revoked']
        && data.expiresAt is int && data.expiresAt > 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validAdminModuleReview() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let note = request.resource.data.get('reviewNote', '');
      return isRmtAdmin()
        && resource.data.status in ['requested', 'reviewing']
        && request.resource.data.status in ['reviewing', 'ready', 'declined']
        && (request.resource.data.status == 'reviewing'
          ? resource.data.status == 'requested'
          : resource.data.status == 'reviewing' && note.size() >= 10)
        && request.resource.data.requestedAt == resource.data.requestedAt
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.updatedAt == request.time
        && changed.hasOnly(['status', 'reviewNote', 'reviewedAt', 'updatedAt']);
    }

    match /users/{userId} {
      allow read, delete: if ownsProfile(userId);
      allow create: if ownsProfile(userId) && validUserDocument(request.resource.data);
      allow update: if ownsProfile(userId)
        && validUserDocument(request.resource.data)
        && validUserUpdate();

      match /watchlist/{slotId} {
        allow read: if ownsProfile(userId);
        allow create: if ownsProfile(userId)
          && validWatchlistEntry(slotId, request.resource.data)
          && watchlistMatchesParent(userId, request.resource.data);
        allow update: if ownsProfile(userId)
          && validWatchlistEntry(slotId, request.resource.data)
          && (request.resource.data == resource.data
            || request.resource.data.listUpdatedAt > resource.data.listUpdatedAt)
          && watchlistMatchesParent(userId, request.resource.data);
        allow delete: if ownsProfile(userId)
          && (!existsAfter(/databases/$(database)/documents/users/$(userId))
            || getAfter(/databases/$(database)/documents/users/$(userId)).data.watchlistUpdatedAt
              > resource.data.listUpdatedAt);
      }

      match /projectFollows/{projectId} {
        allow read: if ownsProfile(userId);
        allow create: if ownsProfile(userId)
          && hasProfile(userId)
          && get(/databases/$(database)/documents/projects/$(projectId)).data.status == 'live'
          && validProjectFollow(projectId, request.resource.data)
          && request.resource.data.followedAt == request.time
          && followAddsOneToStats(projectId);
        allow delete: if ownsProfile(userId)
          && followRemovesOneFromStats(projectId);
      }

      match /referralProfile/{documentId} {
        allow read: if ownsProfile(userId);
        allow create: if documentId == 'current'
          && ownsProfile(userId)
          && validReferralProfile(request.resource.data)
          && request.resource.data.createdAt == request.time
          && referralProfileCreatesCode(userId, request.resource.data.code);
      }

      match /referralClaim/{documentId} {
        allow read: if ownsProfile(userId);
        allow create: if documentId == 'current'
          && ownsProfile(userId)
          && hasProtectedProfile(userId)
          && validReferralClaim(request.resource.data)
          && request.resource.data.claimedAt == request.time
          && referralClaimAddsActivation(userId, request.resource.data.code);
      }
    }

    match /communityRooms/{roomId} {
      allow read: if true;
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow read: if resource.data.status == 'visible';
        allow create, update, delete: if false;
      }
    }

    match /communityActors/{authorKey} {
      allow read, create, update, delete: if false;
    }

    match /communityPresence/{authorKey} {
      allow read, create, update, delete: if false;
    }

    match /communityReports/{reportId} {
      allow read, create, update, delete: if false;
    }

    match /communityModerationAudit/{auditId} {
      allow read, create, update, delete: if false;
    }

    match /communityFeedback/{feedbackId} {
      allow read, create, update, delete: if false;
    }

    match /communityFeedbackStatus/{feedbackId} {
      allow read: if resource.data.status in ['submitted', 'under_review', 'planned', 'shipped', 'closed'];
      allow create, update, delete: if false;
    }

    match /communityFeedbackAudit/{auditId} {
      allow read, create, update, delete: if false;
    }

    match /communityRateLimits/{bucketId} {
      allow read, create, update, delete: if false;
    }

    match /communityMaintenance/{documentId} {
      allow read, create, update, delete: if false;
    }

    match /creatorApplications/{userId} {
      allow read: if ownsProfile(userId) || isRmtAdmin();
      allow create: if validCreatorApplication(request.resource.data)
        && validApplicationCreate(userId);
      allow update: if validCreatorApplication(request.resource.data)
        && (validApplicationResubmission(userId) || validAdminReview());
    }

    match /projects/{projectId} {
      allow read: if resource.data.status == 'live';
      allow create: if isRmtAdmin()
        && validPublicProject(projectId, request.resource.data)
        && request.resource.data.publishedAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if validPublicProject(projectId, request.resource.data)
        && (
          (isRmtAdmin()
            && request.resource.data.publishedAt == resource.data.publishedAt
            && request.resource.data.updatedAt == request.time)
          || validCreatorProjectIdentityUpdate(projectId)
        );
      allow delete: if isRmtAdmin();

      match /gameUpdates/{updateId} {
        allow read: if get(/databases/$(database)/documents/projects/$(projectId)).data.status == 'live';
        allow create: if ownsProjectAssignment(projectId)
          && projectHasGameModule(projectId)
          && validGameUpdate(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if ownsProjectAssignment(projectId)
          && projectHasGameModule(projectId)
          && validGameUpdate(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
        allow delete: if ownsProjectAssignment(projectId);
      }
    }

    match /projectAssignments/{projectId} {
      allow read: if isRmtAdmin()
        || (request.auth != null
          && request.auth.token.email_verified == true
          && resource.data.ownerId == request.auth.uid);
      allow create: if isRmtAdmin()
        && validProjectAssignment(projectId, request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isRmtAdmin()
        && validProjectAssignment(projectId, request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if isRmtAdmin();

      match /moduleRequests/{module} {
        allow read: if isRmtAdmin() || ownsProjectAssignment(projectId);
        allow create: if ownsProjectAssignment(projectId)
          && module in get(/databases/$(database)/documents/projectAssignments/$(projectId)).data.allowedModules
          && validModuleActivationRequest(module, request.resource.data)
          && request.resource.data.status == 'requested'
          && request.resource.data.requestedAt == request.time
          && request.resource.data.updatedAt == request.time
          && !request.resource.data.keys().hasAny(['reviewedAt', 'reviewNote']);
        allow update: if validAdminModuleReview()
          && validModuleActivationRequest(module, request.resource.data)
          && request.resource.data.requestedAt == resource.data.requestedAt;
      }

      match /assets/{assetId} {
        allow read: if isRmtAdmin() || ownsProjectAssignment(projectId);
        allow create: if ownsProjectAssignment(projectId)
          && projectAssignmentAllowsAsset(projectId, request.resource.data.assetType)
          && validCreatorAsset(assetId, projectId, request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if ownsProjectAssignment(projectId)
          && projectAssignmentAllowsAsset(projectId, request.resource.data.assetType)
          && validCreatorAsset(assetId, projectId, request.resource.data)
          && request.resource.data.schemaVersion == resource.data.schemaVersion
          && request.resource.data.assetId == resource.data.assetId
          && request.resource.data.projectSlug == resource.data.projectSlug
          && request.resource.data.status == resource.data.status
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
        allow delete: if ownsProjectAssignment(projectId)
          && resource.data.status == 'draft';

        match /consentInvitations/{invitationId} {
          allow read: if isRmtAdmin() || ownsProjectAssignment(projectId);
          allow create: if ownsProjectAssignment(projectId)
            && validCreatorConsentInvitation(invitationId, projectId, assetId, request.resource.data)
            && request.resource.data.status == 'pending'
            && request.resource.data.revokedAt == null
            && request.resource.data.draftRevisionHash
              == get(/databases/$(database)/documents/projectAssignments/$(projectId)/assets/$(assetId)).data.draftRevisionHash
            && getAfter(/databases/$(database)/documents/creatorConsentStatuses/$(invitationId)).data.status == 'pending'
            && getAfter(/databases/$(database)/documents/creatorConsentStatuses/$(invitationId)).data.projectSlug == projectId
            && getAfter(/databases/$(database)/documents/creatorConsentStatuses/$(invitationId)).data.assetId == assetId
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time;
          allow update: if ownsProjectAssignment(projectId)
            && validCreatorConsentInvitation(invitationId, projectId, assetId, request.resource.data)
            && resource.data.status == 'pending'
            && request.resource.data.status == 'revoked'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'revokedAt', 'updatedAt'])
            && request.resource.data.revokedAt == request.time
            && getAfter(/databases/$(database)/documents/creatorConsentStatuses/$(invitationId)).data.status == 'revoked'
            && request.resource.data.updatedAt == request.time;
          allow delete: if false;
        }

        match /releaseReviews/{reviewId} {
          allow read: if isRmtAdmin() || ownsProjectAssignment(projectId);
          allow create, update, delete: if false;
        }

        match /mediaReceipts/{receiptId} {
          allow read: if isRmtAdmin() || ownsProjectAssignment(projectId);
          allow create, update, delete: if false;
        }
      }
    }

    match /creatorConsentStatuses/{invitationId} {
      allow read: if true;
      allow create: if validCreatorConsentPublicStatus(invitationId, request.resource.data)
        && ownsProjectAssignment(request.resource.data.projectSlug)
        && request.resource.data.status == 'pending'
        && getAfter(/databases/$(database)/documents/projectAssignments/$(request.resource.data.projectSlug)/assets/$(request.resource.data.assetId)/consentInvitations/$(invitationId)).data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if validCreatorConsentPublicStatus(invitationId, request.resource.data)
        && ownsProjectAssignment(request.resource.data.projectSlug)
        && resource.data.status == 'pending'
        && request.resource.data.status == 'revoked'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && getAfter(/databases/$(database)/documents/projectAssignments/$(request.resource.data.projectSlug)/assets/$(request.resource.data.assetId)/consentInvitations/$(invitationId)).data.status == 'revoked'
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /creatorReleaseDecisions/{reviewId} {
      allow read: if isRmtAdmin()
        || ownsProjectAssignment(resource.data.projectSlug);
      allow create, update, delete: if false;
    }

    match /{path=**}/moduleRequests/{module} {
      allow read: if isRmtAdmin();
    }

    match /projectStats/{projectId} {
      allow read: if get(/databases/$(database)/documents/projects/$(projectId)).data.status == 'live';
      allow create: if request.auth != null
        && request.auth.token.email_verified == true
        && hasProfile(request.auth.uid)
        && get(/databases/$(database)/documents/projects/$(projectId)).data.status == 'live'
        && validProjectStats(projectId, request.resource.data)
        && request.resource.data.followerCount == 1
        && request.resource.data.updatedAt == request.time
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/projectFollows/$(projectId))
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/projectFollows/$(projectId));
      allow update: if request.auth != null
        && request.auth.token.email_verified == true
        && hasProfile(request.auth.uid)
        && get(/databases/$(database)/documents/projects/$(projectId)).data.status == 'live'
        && validProjectStats(projectId, request.resource.data)
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.projectSlug == resource.data.projectSlug
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followerCount', 'updatedAt'])
        && (
          (!exists(/databases/$(database)/documents/users/$(request.auth.uid)/projectFollows/$(projectId))
            && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/projectFollows/$(projectId))
            && request.resource.data.followerCount == resource.data.followerCount + 1)
          || (exists(/databases/$(database)/documents/users/$(request.auth.uid)/projectFollows/$(projectId))
            && !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/projectFollows/$(projectId))
            && resource.data.followerCount > 0
            && request.resource.data.followerCount == resource.data.followerCount - 1)
        );
    }

    match /referralCodes/{code} {
      allow read: if request.auth != null
        && request.auth.token.email_verified == true
        && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null
        && request.auth.token.email_verified == true
        && hasProfile(request.auth.uid)
        && validReferralCode(code, request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.verifiedActivations == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/referralProfile/current)
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/referralProfile/current).data.code == code;
      allow update: if request.auth != null
        && request.auth.token.email_verified == true
        && hasProtectedProfile(request.auth.uid)
        && validReferralCode(code, request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.code == resource.data.code
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.verifiedActivations == resource.data.verifiedActivations + 1
        && request.resource.data.updatedAt == request.time
        && request.auth.uid != resource.data.ownerId
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/referralClaim/current)
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/referralClaim/current)
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/referralClaim/current).data.code == code;
    }
  }
}
