{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit local Reclaim dashboard controller policy",
  "$comment": "Fixture-only policy. It does not activate production or assign a live controller, campaign, collection or reward token.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profile", "scope", "chainId", "reclaimFactory", "factoryRuntimeHash", "authorizedControllers"],
  "properties": {
    "schemaVersion": {"const": 1},
    "profile": {"const": "rmt-reclaim-administration-policy-v1"},
    "scope": {"const": "isolated-local"},
    "chainId": {"const": 31337},
    "reclaimFactory": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
    "factoryRuntimeHash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
    "authorizedControllers": {
      "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["address", "runtimeHash"],
        "properties": {
          "address": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
          "runtimeHash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"}
        }
      }
    }
  }
}
